def _parse_art(lines: list[str], y_top: int) -> list[tuple[int, int, str, str]]:
    """Convert multi-line ASCII art into (dx, dy, char, role) tuples."""
    out = []
    for row_idx, line in enumerate(lines):
        dy = y_top + row_idx
        for dx, ch in enumerate(line):
            if ch == " ":
                continue
            if ch in ("✦", "*", "°", "▪"):
                role = "glint"
            elif ch in ("·", "▫", ":"):
                role = "rim"
            else:
                role = "body"
            out.append((dx, dy, ch, role))
    return out


