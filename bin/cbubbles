def print_rich_help() -> None:
    """Print the formatted truecolor reference guide to stdout."""
    R = "\033[38;2;255;113;132m"
    G = "\033[38;2;74;214;154m"
    B = "\033[38;2;115;163;255m"
    W = "\033[38;2;248;251;255m"
    M = "\033[38;2;141;157;180m"
    BOLD = "\033[1m"
    RST = "\033[0m"

    guide = f"""{BOLD}{R}c{G}b{B}u{R}b{G}b{B}l{R}e{G}s{RST} — {W}Underwater RGB Bubble ASCII & Pixel Terminal Animation{RST}

{BOLD}{B}USAGE{RST}
  {G}cbubbles{RST} [options]
  {G}cbubbles{RST} {M}help | -h | --help{RST}

{BOLD}{B}DEFAULT BEHAVIOR{RST}
  Running plain {G}cbubbles{RST} uses the signature {R}Red (#FF7184){RST}, {G}Green (#4AD69A){RST}, and
  {B}Blue (#73A3FF){RST} truecolor palette with randomized bubble dimensions across all
  {W}7 size tiers{RST} (from tiny micro-bubbles up to 26×11 giant hollow glass spheres).

{BOLD}{B}CLI OPTIONS{RST}
  {G}-s{RST}, {G}--speed{RST} {W}MULT{RST}       Rising speed multiplier ({M}0.2{RST} slow drift → {M}4.0{RST} rapid boil; default: {W}1.0{RST})
  {G}-S{RST}, {G}--size{RST} {W}MODE{RST}        Dimension variability (default: {W}random{RST}):
                           • {W}random{RST}  : all 7 tiers (micro droplets up to giant spheres)
                           • {W}small{RST}   : tiers 1–2      • {W}medium{RST} : tiers 2–4
                           • {W}large{RST}   : tiers 4–6      • {W}giant{RST}  : tiers 5–7 (massive glass bubbles)
                           • {W}1-7{RST}     : custom tier range (e.g. {G}-S 3-7{RST} or single tier {G}-S 7{RST})
  {G}-c{RST}, {G}--color{RST} {W}PALETTE{RST}    Color palette (default: {W}rgb{RST}):
                           • {W}rgb{RST} ({R}Red{RST}+{G}Green{RST}+{B}Blue{RST})  • {W}ocean{RST} (Blue+Green+Cyan)  • {W}coral{RST} (Red+Magenta+Blue)
                           • {W}red{RST}, {W}green{RST}, {W}blue{RST}, {W}mono{RST}, or custom comma list (e.g. {G}-c red,blue{RST})
  {G}-d{RST}, {G}--density{RST} {W}COUNT{RST}    Number of simultaneous bubbles on screen ({M}5{RST} to {M}160{RST}; default: {W}35{RST})
  {G}-m{RST}, {G}--style{RST} {W}STYLE{RST}      Character aesthetic: {W}mixed{RST} (rounded + glints), {W}ascii{RST}, or {W}pixel{RST} (default: {W}mixed{RST})
  {G}-w{RST}, {G}--wobble{RST} {W}MULT{RST}      Horizontal underwater sway/turbulence ({M}0.0{RST} to {M}3.0{RST}; default: {W}1.0{RST})
  {G}-p{RST}, {G}--pop{RST} {W}RATE{RST}         Mid-water bubble pop frequency ({M}0.0{RST} to {M}1.0{RST}; default: {W}0.25{RST})
  {G}-l{RST}, {G}--logo{RST}             Show centered pixelated {W}OMARCHY{RST} wordmark that dynamically tints
                         as RGB bubbles pass through it (3-layer parallax depth)
  {G}-f{RST}, {G}--fps{RST} {W}FPS{RST}          Target frame rate ({M}10{RST} to {M}60{RST}; default: {W}30{RST})
  {G}-h{RST}, {G}--help{RST}             Show this help guide and exit

{BOLD}{B}LIVE INTERACTIVE HOTKEYS (WHILE RUNNING){RST}
  {W}+ / -{RST} (or {W}↑ / ↓{RST})       Increase / decrease bubble {W}speed{RST}
  {W}] / [{RST} (or {W}→ / ←{RST})       Increase / decrease bubble {W}density{RST}
  {W}z{RST}                      Cycle {W}size modes{RST} ({M}random → small → medium → large → giant{RST})
  {W}c{RST}                      Cycle {W}color palettes{RST} ({M}rgb → ocean → coral → red → green → blue → mono{RST})
  {W}m{RST}                      Cycle {W}character style{RST} ({M}mixed → ascii → pixel{RST})
  {W}l{RST}                      Toggle centered {W}OMARCHY pixel logo{RST} on/off
  {W}p{RST}                      Trigger an instant {W}bubble burst{RST} wave from the bottom
  {W}Space{RST}                  {W}Pause / resume{RST} animation (perfect for capturing screenshots)
